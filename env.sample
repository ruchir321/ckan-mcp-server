# CKAN portal base URL (required)
CKAN_URL=https://ckan0.cf.opendata.inter.prod-toronto.ca

# Optional: API key for write/protected operations
# CKAN_API_KEY=your-api-key-here

# Optional: HTTP basic auth for protected CKAN sites
# CKAN_BASIC_AUTH_USERNAME=
# CKAN_BASIC_AUTH_PASSWORD=

# Optional: SSRF allowlist for the document tools (ckan_read_web_document / crawler).
# By default only public http(s) hosts are fetched; private/loopback/link-local
# addresses are blocked. Set this to a comma-separated list to restrict fetches to
# an explicit allowlist of hosts instead.
# CKAN_DOC_ALLOWED_HOSTS=www.toronto.ca,toronto.ca

# Optional: expose the lower-value list/health endpoints (package_list, organization_*,
# group_list, tag_list, resource_show, site_read, status_show) in addition to the default
# lean tool set. Set to 1 to enable.
# CKAN_EXPOSE_ALL_TOOLS=1

# ---- Civic-answer agent + eval harness (optional; `uv sync --extra agent`) ----

# Anthropic API key for the grounded agent and the LLM-judge evaluators.
# ANTHROPIC_API_KEY=sk-ant-...
# Override the agent model (default: claude-sonnet-4-6).
# CIVIC_AGENT_MODEL=claude-sonnet-4-6

# Self-hosted Langfuse (eval tracing/datasets/experiments). Tracing is a no-op
# unless LANGFUSE_PUBLIC_KEY is set, so the agent runs fine without these.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
